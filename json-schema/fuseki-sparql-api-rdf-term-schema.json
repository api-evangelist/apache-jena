{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/apache-jena/refs/heads/main/json-schema/fuseki-sparql-api-rdf-term-schema.json",
  "title": "RDFTerm",
  "description": "An RDF term (URI, literal, or blank node)",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "uri",
        "literal",
        "bnode"
      ],
      "example": "uri"
    },
    "value": {
      "type": "string",
      "example": "http://example.org/subject"
    },
    "datatype": {
      "type": "string",
      "description": "Datatype URI for typed literals"
    },
    "xml:lang": {
      "type": "string",
      "description": "Language tag for language-tagged literals"
    }
  }
}